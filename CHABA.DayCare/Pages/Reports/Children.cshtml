@page
@model CHABA.DayCare.Pages.Reports.ChildrenModel

@{
    ViewData["Title"] = "Children Report";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Children Details Report</h2>

        <div>

            <form method="post"
                  asp-page-handler="Export"
                  class="d-inline">

                <button type="submit"
                        class="btn btn-success me-2">
                    Export to Excel
                </button>

            </form>

            <a asp-page="/Reports/Index"
               class="btn btn-secondary">
                Back to Reports
            </a>

        </div>

    </div>

    <div class="card">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped">

                    <thead class="table-dark">

                        <tr>
                            <th>Child Name</th>
                            <th>Date of Birth</th>
                            <th>Admission Date</th>
                            <th>Gender</th>
                            <th>Classroom</th>
                            <th>Status</th>
                            <th>Allergies</th>
                            <th>Medical Conditions</th>
                            <th>Doctor</th>
                            <th>Doctor Phone</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Children.Any())
                        {
                            foreach (var child in Model.Children)
                            {
                                <tr>

                                    <td>
                                        @child.FirstName @child.LastName
                                    </td>

                                    <td>
                                        @child.DateOfBirth.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @child.AdmissionDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @child.Gender
                                    </td>

                                    <td>
                                        @child.Classroom?.Name
                                    </td>

                                    <td>
                                        @child.Status
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(child.Allergies)
                                                                        ? "-"
                                                                        : child.Allergies)
                                                                                      </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(child.MedicalConditions)
                                                                        ? "-"
                                                                        : child.MedicalConditions)
                                                                                              </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(child.DoctorName)
                                                                        ? "-"
                                                                        : child.DoctorName)
                                                                                       </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(child.DoctorPhone)
                                                                        ? "-"
                                                                        : child.DoctorPhone)
                            </td>

                                </tr>
                                                }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10"
                                    class="text-center">
                                    No children found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>