@page
@model CHABA.DayCare.Pages.Reports.IndexModel

@{
    ViewData["Title"] = "Reports";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Reports</h2>

        <a asp-page="/Index" class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="row">

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Staff Details
                    </h5>

                    <p class="card-text">
                        View staff information including
                        ID numbers, roles, qualifications,
                        contact details and date joined.
                    </p>

                    <p>
                        <strong>@Model.StaffCount</strong>
                        staff members
                    </p>

                    <a asp-page="Staff"
                       class="btn btn-primary">
                        View Staff Report
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Children Details
                    </h5>

                    <p class="card-text">
                        View registered children including
                        classroom, admission, status and
                        medical information.
                    </p>

                    <p>
                        <strong>Children</strong>
                    </p>

                    <a asp-page="Children"
                       class="btn btn-primary">
                        View Children Report
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Guardians Details
                    </h5>

                    <p class="card-text">
                        View guardian information including
                        relationships, contact details and
                        emergency contact information.
                    </p>

                    <p>
                        <strong>Guardians</strong>
                    </p>

                    <a asp-page="Guardians"
                       class="btn btn-primary">
                        View Guardians Report
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Attendance Report
                    </h5>

                    <p class="card-text">
                        View attendance records by date,
                        including attendance status,
                        arrival and departure times.
                    </p>

                    <a asp-page="Attendance"
                       class="btn btn-primary">
                        View Attendance Report
                    </a>

                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        Payments Report
                    </h5>

                    <p class="card-text">
                        View payments by date range,
                        including payment amounts,
                        methods and references.
                    </p>

                    <a asp-page="Payments"
                       class="btn btn-primary">
                        View Payments Report
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>