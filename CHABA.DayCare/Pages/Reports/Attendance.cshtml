@page
@model CHABA.DayCare.Pages.Reports.AttendanceModel

@{
    ViewData["Title"] = "Attendance Report";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h2>Attendance Report</h2>

        <a asp-page="/Reports/Index"
           class="btn btn-secondary">
            Back to Reports
        </a>

    </div>

    <div class="card mb-4">

        <div class="card-body">

            <form method="get"
                  class="row g-3 align-items-end">

                <div class="col-md-4">

                    <label asp-for="SelectedDate"
                           class="form-label">
                        Attendance Date
                    </label>

                    <input asp-for="SelectedDate"
                           type="date"
                           class="form-control" />

                </div>

                <div class="col-md-2">

                    <button type="submit"
                            class="btn btn-primary">
                        View Report
                    </button>

                </div>

            </form>

        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4>
            Attendance for
            @Model.SelectedDate.ToString("dd/MM/yyyy")
        </h4>

        <form method="post"
              asp-page-handler="Export">

            <input type="hidden"
                   name="selectedDate"
                   value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

            <button type="submit"
                    class="btn btn-success">
                Export to Excel
            </button>

        </form>

    </div>

    @if (Model.AttendanceRecords.Any())
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>Child</th>
                        <th>Status</th>
                        <th>Arrival Time</th>
                        <th>Departure Time</th>
                        <th>Notes</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var attendance in Model.AttendanceRecords)
                    {
                        <tr>

                            <td>
                                @attendance.Child.FirstName
                                @attendance.Child.LastName
                            </td>

                            <td>
                                @attendance.Status
                            </td>

                            <td>
                                @(attendance.ArrivalTime?.ToString(@"hh\:mm") ?? "-")
                            </td>

                            <td>
                                @(attendance.DepartureTime?.ToString(@"hh\:mm") ?? "-")
                            </td>

                            <td>
                                @(attendance.Notes ?? "-")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No attendance records were found for
            @Model.SelectedDate.ToString("dd/MM/yyyy").
        </div>
    }

</div>