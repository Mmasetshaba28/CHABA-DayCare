@page
@model CHABA.DayCare.Pages.Organisation.SetupModel
@{
    ViewData["Title"] = "Organisation Setup";
}

<h2>Organisation Setup</h2>


<p>Please complete your organisation details before using the system.</p>

<form method="post">

    <div class="mb-3">
        <label asp-for="Organisation.Name"></label>
        <input asp-for="Organisation.Name" class="form-control" />
        <span asp-validation-for="Organisation.Name" class="text-danger"></span>
    </div>


    <div class="mb-3">
        <label asp-for="Organisation.RegistrationNumber"></label>
        <input asp-for="Organisation.RegistrationNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Organisation.PrincipalName"></label>
        <input asp-for="Organisation.PrincipalName" class="form-control" />
        <span asp-validation-for="Organisation.PrincipalName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Organisation.PhoneNumber"></label>
        <input asp-for="Organisation.PhoneNumber" class="form-control" />
        <span asp-validation-for="Organisation.PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Organisation.Email"></label>
        <input asp-for="Organisation.Email" class="form-control" />
        <span asp-validation-for="Organisation.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Organisation.PhysicalAddress"></label>
        <input asp-for="Organisation.PhysicalAddress" class="form-control" />
        <span asp-validation-for="Organisation.PhysicalAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Organisation.Motto"></label>
        <input asp-for="Organisation.Motto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Save Organisation
    </button>
</form>

        @section Scripts {
            <partial name="_ValidationScriptsPartial" />
}