@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h2>@Model.Dashboard.OrganisationName</h2>

    <p class="text-muted">
        @Model.Dashboard.Motto
    </p>

    <hr />

    <div class="row">

        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Children</h5>
                    <h2>@Model.Dashboard.ChildrenCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Classrooms</h5>
                    <h2>@Model.Dashboard.ClassroomCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Teachers</h5>
                    <h2>@Model.Dashboard.TeacherCount</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5>Parents</h5>
                    <h2>@Model.Dashboard.ParentCount</h2>
                </div>
            </div>
        </div>

    </div>

    <hr />

    <h4>Quick Actions</h4>

    <div class="mt-3">

        <a class="btn btn-primary me-2">
            Register Child
        </a>

        <a class="btn btn-success me-2">
            Record Attendance
        </a>

        <a class="btn btn-warning me-2">
            Receive Payment
        </a>

        <a class="btn btn-secondary">
            Reports
        </a>

    </div>

</div>