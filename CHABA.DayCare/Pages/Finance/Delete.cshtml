@page "{id:int}"
@model CHABA.DayCare.Pages.Finance.DeleteModel

@{
    ViewData["Title"] = "Delete Payment";
}

<h2>Delete Payment</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this payment?</strong>
    <br />
    This payment will be removed from the active payment list.
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Child
            </dt>

            <dd class="col-sm-9">
                @Model.Payment.Child.FirstName
                @Model.Payment.Child.LastName
            </dd>

            <dt class="col-sm-3">
                Amount
            </dt>

            <dd class="col-sm-9">
                R @Model.Payment.Amount.ToString("N2")
            </dd>

            <dt class="col-sm-3">
                Payment Date
            </dt>

            <dd class="col-sm-9">
                @Model.Payment.PaymentDate.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">
                Payment Method
            </dt>

            <dd class="col-sm-9">
                @Model.Payment.PaymentMethod
            </dd>

            <dt class="col-sm-3">
                Reference Number
            </dt>

            <dd class="col-sm-9">
                @(Model.Payment.ReferenceNumber ?? "-")
            </dd>

            <dt class="col-sm-3">
                Description
            </dt>

            <dd class="col-sm-9">
                @(Model.Payment.Description ?? "-")
            </dd>

        </dl>

        <form method="post">

            <input type="hidden"
                   asp-for="Payment.Id" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Payment
            </button>

            <a asp-page="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>