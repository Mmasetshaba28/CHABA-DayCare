@page
@model CHABA.DayCare.Pages.Finance.CreateModel

@{
    ViewData["Title"] = "Record Payment";
}

<h2>Record Payment</h2>

<form method="post">

    <div class="mb-3">
        <label asp-for="Payment.ChildId" class="form-label"></label>

        <select asp-for="Payment.ChildId"
                asp-items="Model.Payment.Children"
                class="form-select">

            <option value="">-- Select Child --</option>

        </select>

        <span asp-validation-for="Payment.ChildId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Payment.Amount" class="form-label"></label>

        <div class="input-group">
            <span class="input-group-text">R</span>

            <input asp-for="Payment.Amount"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0.01" />
        </div>

        <span asp-validation-for="Payment.Amount"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Payment.PaymentDate"
               class="form-label"></label>

        <input asp-for="Payment.PaymentDate"
               type="date"
               class="form-control" />

        <span asp-validation-for="Payment.PaymentDate"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Payment.PaymentMethod"
               class="form-label"></label>

        <select asp-for="Payment.PaymentMethod"
                class="form-select">

            <option value="">-- Select Payment Method --</option>
            <option value="Cash">Cash</option>
            <option value="EFT">EFT</option>
            <option value="Card">Card</option>
            <option value="Other">Other</option>

        </select>

        <span asp-validation-for="Payment.PaymentMethod"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Payment.ReferenceNumber"
               class="form-label"></label>

        <input asp-for="Payment.ReferenceNumber"
               class="form-control" />

        <span asp-validation-for="Payment.ReferenceNumber"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Payment.Description"
               class="form-label"></label>

        <input asp-for="Payment.Description"
               class="form-control"
               placeholder="e.g. August 2026 school fees" />

        <span asp-validation-for="Payment.Description"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Payment.Notes"
               class="form-label"></label>

        <textarea asp-for="Payment.Notes"
                  class="form-control"
                  rows="4"></textarea>

        <span asp-validation-for="Payment.Notes"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Save Payment
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}