@page
@model CHABA.DayCare.Pages.Guardians.EditModel

@{
    ViewData["Title"] = "Edit Guardian";
}

<h2>Edit Guardian</h2>

<form method="post">

    <div class="mb-3">
        <label asp-for="Guardian.FirstName" class="form-label"></label>
        <input asp-for="Guardian.FirstName" class="form-control" />
        <span asp-validation-for="Guardian.FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.LastName" class="form-label"></label>
        <input asp-for="Guardian.LastName" class="form-control" />
        <span asp-validation-for="Guardian.LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.Relationship" class="form-label"></label>
        <input asp-for="Guardian.Relationship" class="form-control" />
        <span asp-validation-for="Guardian.Relationship" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.PhoneNumber" class="form-label"></label>
        <input asp-for="Guardian.PhoneNumber" class="form-control" />
        <span asp-validation-for="Guardian.PhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.AlternativePhoneNumber" class="form-label"></label>
        <input asp-for="Guardian.AlternativePhoneNumber" class="form-control" />
        <span asp-validation-for="Guardian.AlternativePhoneNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.Email" class="form-label"></label>
        <input asp-for="Guardian.Email" class="form-control" />
        <span asp-validation-for="Guardian.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.PhysicalAddress" class="form-label"></label>
        <input asp-for="Guardian.PhysicalAddress" class="form-control" />
        <span asp-validation-for="Guardian.PhysicalAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.Occupation" class="form-label"></label>
        <input asp-for="Guardian.Occupation" class="form-control" />
        <span asp-validation-for="Guardian.Occupation" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.Employer" class="form-label"></label>
        <input asp-for="Guardian.Employer" class="form-control" />
        <span asp-validation-for="Guardian.Employer" class="text-danger"></span>
    </div>

    <div class="form-check mb-2">
        <input asp-for="Guardian.IsPrimaryContact" class="form-check-input" />
        <label asp-for="Guardian.IsPrimaryContact" class="form-check-label"></label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Guardian.IsEmergencyContact" class="form-check-input" />
        <label asp-for="Guardian.IsEmergencyContact" class="form-check-label"></label>
    </div>

    <div class="mb-3">
        <label asp-for="Guardian.ChildId" class="form-label"></label>

        <select asp-for="Guardian.ChildId"
                asp-items="Model.Guardian.Children"
                class="form-select">
            <option value="">-- Select Child --</option>
        </select>

        <span asp-validation-for="Guardian.ChildId" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-page="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}