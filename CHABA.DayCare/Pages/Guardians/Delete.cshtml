@page
@model CHABA.DayCare.Pages.Guardians.DeleteModel

@{
    ViewData["Title"] = "Delete Guardian";
}

<h2>Delete Guardian</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this guardian?</strong>
    <br />
    This action cannot be undone.
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Guardian
            </dt>
            <dd class="col-sm-9">
                @Model.Guardian.FirstName @Model.Guardian.LastName
            </dd>

            <dt class="col-sm-3">
                Relationship
            </dt>
            <dd class="col-sm-9">
                @Model.Guardian.Relationship
            </dd>

            <dt class="col-sm-3">
                Phone Number
            </dt>
            <dd class="col-sm-9">
                @Model.Guardian.PhoneNumber
            </dd>

            <dt class="col-sm-3">
                Child
            </dt>
            <dd class="col-sm-9">
                @Model.Guardian.Child.FirstName @Model.Guardian.Child.LastName
            </dd>

        </dl>

        <form method="post">

            <input type="hidden" asp-for="Guardian.Id" />

            <button type="submit" class="btn btn-danger">
                Delete Guardian
            </button>

            <a asp-page="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>