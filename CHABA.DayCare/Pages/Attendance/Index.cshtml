@page
@model CHABA.DayCare.Pages.Attendance.IndexModel

@{
    ViewData["Title"] = "Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Attendance</h2>

    <a asp-page="Create" class="btn btn-primary">
        Record Attendance
    </a>

</div>
<div class="card mb-4">
    <div class="card-body">

        <form method="get" class="row g-3 align-items-end">

            <div class="col-md-4">

                <label asp-for="SelectedDate"
                       class="form-label">
                    Attendance Date
                </label>

                <input asp-for="SelectedDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-2">

                <button type="submit"
                        class="btn btn-primary">
                    View Attendance
                </button>

            </div>

        </form>

    </div>
</div>

<div class="row mb-4">

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body text-center">

                <h6 class="text-muted">
                    Present
                </h6>

                <h2>
                    @Model.PresentCount
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body text-center">

                <h6 class="text-muted">
                    Absent
                </h6>

                <h2>
                    @Model.AbsentCount
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body text-center">

                <h6 class="text-muted">
                    Late
                </h6>

                <h2>
                    @Model.LateCount
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body text-center">

                <h6 class="text-muted">
                    Excused
                </h6>

                <h2>
                    @Model.ExcusedCount
                </h2>

            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card h-100">
            <div class="card-body text-center">

                <h6 class="text-muted">
                    Not Recorded
                </h6>

                <h2>
                    @Model.NotRecordedCount
                </h2>

            </div>
        </div>
    </div>

</div>

@if (Model.AttendanceRecords.Any())
{
    <div class="table-responsive">
        <table class="table table-bordered table-hover">

            <thead class="table-light">
                <tr>
                    <th>Child</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Arrival</th>
                    <th>Departure</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var attendance in Model.AttendanceRecords)
                {
                    <tr>
                        <td>
                            @attendance.Child.FirstName
                            @attendance.Child.LastName
                        </td>

                        <td>
                            @attendance.Date.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @attendance.Status
                        </td>

                        <td>
                            @(attendance.ArrivalTime?.ToString(@"hh\:mm") ?? "-")
                        </td>

                        <td>
                            @(attendance.DepartureTime?.ToString(@"hh\:mm") ?? "-")
                        </td>

                        <td>
                            @(attendance.Notes ?? "-")
                        </td>
                        <td>
                            <a asp-page="Edit"
                               asp-route-id="@attendance.Id"
                               class="btn btn-sm btn-primary">
                                Edit
                            </a>
                            <a asp-page="Delete"
                               asp-route-id="@attendance.Id"
                               class="btn btn-sm btn-danger">
                                Delete
                            </a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No attendance records have been recorded yet.
    </div>
}