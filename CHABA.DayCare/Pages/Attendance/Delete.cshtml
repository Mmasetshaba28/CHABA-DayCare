@page "{id:int}"
@model CHABA.DayCare.Pages.Attendance.DeleteModel

@{
    ViewData["Title"] = "Delete Attendance";
}

<h2>Delete Attendance</h2>

<div class="alert alert-warning">
    <strong>Are you sure you want to delete this attendance record?</strong>
</div>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">
                Child
            </dt>
            <dd class="col-sm-9">
                @Model.Attendance.Child.FirstName @Model.Attendance.Child.LastName
            </dd>

            <dt class="col-sm-3">
                Date
            </dt>
            <dd class="col-sm-9">
                @Model.Attendance.Date.ToString("dd/MM/yyyy")
            </dd>

            <dt class="col-sm-3">
                Status
            </dt>
            <dd class="col-sm-9">
                @Model.Attendance.Status
            </dd>

            <dt class="col-sm-3">
                Arrival Time
            </dt>
            <dd class="col-sm-9">
                @(Model.Attendance.ArrivalTime?.ToString(@"hh\:mm") ?? "-")
            </dd>

            <dt class="col-sm-3">
                Departure Time
            </dt>
            <dd class="col-sm-9">
                @(Model.Attendance.DepartureTime?.ToString(@"hh\:mm") ?? "-")
            </dd>

            <dt class="col-sm-3">
                Notes
            </dt>
            <dd class="col-sm-9">
                @(Model.Attendance.Notes ?? "-")
            </dd>

        </dl>

        <form method="post">

            <button type="submit" class="btn btn-danger">
                Delete
            </button>

            <a asp-page="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>